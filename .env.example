# SUPABASE CONFIGURATION: For Vercel + Supabase deployment (Auth, Postgres DB, and Storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# TDH_OWNER_BOOTSTRAP_SECRET: Optional deployment secret to secure the one-time /setup/owner claim.
TDH_OWNER_BOOTSTRAP_SECRET="optional_bootstrap_secret_passphrase"

# PAYSTACK CREDENTIALS: Required before checkout is enabled.
# Missing credentials fail closed; no simulated payments are accepted.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# BREVO TRANSACTIONAL EMAIL: Required for live transactional email delivery via Brevo API v3.
# If omitted, emails accumulate in the durable outbox and can be dispatched when key is set.
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx"
BREVO_SENDER_EMAIL="notifications@theeyasdeluxehub.com"
BREVO_SENDER_NAME="Theeya's Deluxe Hub"
BREVO_REPLY_TO="support@theeyasdeluxehub.com"
